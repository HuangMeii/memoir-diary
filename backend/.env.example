# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx.aws-us-east-1.aws.neon.tech/memoir?sslmode=require

# --- Neon Object Storage (S3-compatible) ---
# Lay 3 gia tri S3_* o Neon Console > Connect > tab "Storage" > Reveal credential.
# S3_ENDPOINT_URL KHONG phai host Postgres: phai co dang
#   https://br-<branch-id>.storage.c-<N>.<region>.aws.neon.tech
# Credential can scope storage:read + storage:write.
S3_ENDPOINT_URL=https://br-<branch-id>.storage.c-<N>.aws-us-east-1.aws.neon.tech
S3_REGION=aws-us-east-1
S3_ACCESS_KEY_ID=nak_live_xxxxxxxx     # = token_id
S3_SECRET_ACCESS_KEY=nsk_live_xxxxxxxx # = s3_secret_access_key
S3_BUCKET=diary-images                 # tao bucket o Console > Object storage > New bucket

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Admin (kho câu) ---
# Tài khoản admin duy nhất quyền sửa câu dùng chung (user_id IS NULL) và quản lý users.
# Tao / nang quyen bang:  python -m app.seed.admin
# Neu bo trong, script dung email/username mac dinh va hoi mat khau o terminal.
# Luu y: bo trong .local/.test/.invalid - API se tu choi mot tai khoan khong doc duoc.
ADMIN_EMAIL=admin@memoir.app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- App ---
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
